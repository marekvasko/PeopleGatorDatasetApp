# Traefik routes https://${SUBDOMAIN}.${BASE_DOMAIN} to this application.
BASE_DOMAIN=capturemyhand.com
SUBDOMAIN=peoplegator-dataset

# Absolute paths are recommended when the dataset is outside this repository.
DATASET_PATH=./dataset

# Optional host directory for the JSONL feedback file.
# Leave empty to use the managed Docker volume.
FEEDBACK_PATH=./feedback
