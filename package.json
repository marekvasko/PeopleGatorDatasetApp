{
  "name": "people-gator-archive",
  "version": "1.0.0",
  "description": "Mobile-first browser for People Gator scanned pages and annotated faces",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-zoom-pan-pinch": "^4.0.4",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
